# Copy to .env and adjust. Never commit a real .env.
# Every setting here maps to a field in backend/app/core/config.py.

# ---- Application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- Datastores -----------------------------------------------------------
# Non-default ports: docker-compose.yml namespaces this project's services so
# they cannot collide with -- or worse, be mistaken for -- other stacks running
# on the standard ports.
DATABASE_URL=postgresql+psycopg://verifier:verifier@localhost:55432/verifier
REDIS_URL=redis://localhost:56379/0

# ---- Object storage (MinIO / S3-compatible) -------------------------------
MINIO_ENDPOINT=http://localhost:59000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=verifier-media
MINIO_REGION=us-east-1
MINIO_SECURE=false

# ---- Local AI -------------------------------------------------------------
# Optional. Absent Ollama degrades claim extraction; it does not break the app.
# Model names are configuration - never hardcode them in application code.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_ENABLED=true

# Multilingual, so a Bangla claim can match an English document directly.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_ENABLED=true

NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_ENABLED=true

# ---- Media tooling --------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OCR_ENGINE=tesseract
TESSERACT_PATH=tesseract
OCR_LANGUAGES=eng+ben
WHISPER_MODEL=base
WHISPER_ENABLED=true

# ---- Upload and media limits ----------------------------------------------
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_RESOLUTION=1920
MAX_KEYFRAMES=24
MAX_TRANSCRIPT_CHARS=50000
MAX_TEXT_CHARS=50000

# ---- Safe fetch / SSRF ----------------------------------------------------
# Do not widen ALLOWED_URL_PORTS casually: non-standard ports are the target of
# most SSRF chains (Redis 6379, Postgres 5432, and friends).
MAX_URL_RESPONSE_BYTES=10485760
FETCH_TIMEOUT_SECONDS=20
MAX_REDIRECTS=5
ALLOWED_URL_PORTS=80,443
USER_AGENT=VerifierBot/1.0 (+https://example.org/about-our-bot)

# ---- Rate limiting --------------------------------------------------------
# No accounts in V1, so limits are per hashed client fingerprint.
# Change the salt in any real deployment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_TEXT_SUBMISSIONS=20
RATE_LIMIT_URL_SUBMISSIONS=20
RATE_LIMIT_IMAGE_SUBMISSIONS=10
RATE_LIMIT_VIDEO_SUBMISSIONS=3
RATE_LIMIT_STATUS_POLLS=1200
RATE_LIMIT_SEARCH=120
CLIENT_FINGERPRINT_SALT=change-me-in-production

# ---- Pipeline / worker ----------------------------------------------------
QUEUE_NAME=verification
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=900
STAGE_TIMEOUT_SECONDS=300
MAX_CLAIMS_PER_VERIFICATION=25
MAX_EVIDENCE_PER_CLAIM=12

# ---- Retrieval ------------------------------------------------------------
# GDELT is free and needs no key.
GDELT_ENABLED=true
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MAX_RECORDS=50
RSS_ENABLED=true
FEEDS_CONFIG_PATH=../infrastructure/feeds.yaml
RSS_INGEST_INTERVAL_SECONDS=900
RETRIEVAL_CANDIDATE_LIMIT=40
